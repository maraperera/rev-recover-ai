# Application Environment
APP_ENV=development
APP_PORT=8000
LOG_LEVEL=INFO

# SAP Business Accelerator Hub Sandbox Configuration
# Obtain your API key by clicking 'Show API Key' in your SAP Accelerator Hub Settings
SAP_API_KEY=your_sap_business_accelerator_hub_api_key
SAP_SANDBOX_BASE_URL=https://sandbox.api.sap.com/s4hanacloud/sap/opu/odata/sap

# AWS Bedrock Configuration (ap-southeast-2 Sydney region recommended)
AWS_REGION=ap-southeast-2
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# RAG & Embeddings
CHROMA_PERSIST_DIRECTORY=./data/vector_store
EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0

# LangSmith Observability
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=your_langsmith_api_key
LANGCHAIN_PROJECT=RevRecover-AI

# LangGraph State Persistence
CHECKPOINT_DB_PATH=./data/checkpoints.sqlite